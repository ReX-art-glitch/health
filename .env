# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database (default local settings for demo)
DATABASE_URL=postgresql://public_health_user:changeme@postgres:5432/public_health_db
POSTGRES_USER=public_health_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=public_health_db

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI (leave blank for demo – AI will fallback to template logic)
OPENAI_API_KEY=

# JWT Authentication
JWT_SECRET_KEY=dev-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (allowed frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# File upload limits
MAX_UPLOAD_SIZE=10485760

# Optional external services (not required for basic demo)
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# AZURE_FORM_RECOGNIZER_ENDPOINT=
# AZURE_FORM_RECOGNIZER_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1